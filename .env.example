# Endpoint do formulário (POST JSON {email, whatsapp, consent}). Vazio = mock local (sem envio).
VITE_FORM_ENDPOINT=

# Base dos arquivos pesados (quadros, vídeos, telas) no Cloudflare R2, sem barra no fim. Vazio = mesmo domínio (dev local).
VITE_ASSET_BASE=

# URL pública da LP, sem barra no fim (ex.: https://cerne.agr.br). Usada no canonical, og:url, og:image, robots.txt e sitemap.xml no build. Vazio = essas tags não são geradas.
VITE_SITE_URL=


# Endereço da Política de Privacidade (link sob o botão do formulário e no rodapé). Vazio = /privacidade (página interna do site).
VITE_PRIVACY_URL=
